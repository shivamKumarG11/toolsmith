# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# LLM — any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=your_llm_key
# Agent model: gemini-3.5-flash-lite shows the fix loop best; sonnet is most reliable
TOOLSMITH_MODEL=google/gemini-3.5-flash-lite

# Stripe TEST mode. `stripe sandboxes create --email you@example.com` gives a test key
# with no account needed.
STRIPE_SECRET_KEY=rk_test_or_sk_test_...
STRIPE_ACCOUNT_ID=acct_...

# CreateOS (from createos.sh → Settings → API Keys)
CREATEOS_API_KEY=skp_...

# Optional: spending cap in cents for auto-approval (default 20000 = $200)
TOOLSMITH_CAP_CENTS=20000
